# ================================================================
# backend/.env.example
# Copy this file to backend/.env and fill in real values.
# Never commit the .env file — it is gitignored.
# ================================================================

# MySQL credentials
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT signing secret (min 32 characters recommended)
JWT_SECRET=your-long-random-jwt-secret-here-at-least-32chars

# Optional: DB URL override (defaults to localhost in application.properties)
# DB_URL=jdbc:mysql://your-rds-host:3306/aiproject

# Optional: Spring profile (dev | prod)
# SPRING_PROFILES_ACTIVE=prod
