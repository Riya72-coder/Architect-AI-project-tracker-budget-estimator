# ================================================================
# chatbot-backend/.env.example
# Copy this file to chatbot-backend/.env and fill in real values.
# Never commit the .env file — it is gitignored.
# ================================================================

# Your Groq API key — get one at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Spring Boot backend URL (local dev default; override for production)
BACKEND_BASE_URL=http://localhost:5000
